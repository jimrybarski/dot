# i3blocks configuration file
#
# The i3blocks man page describes the usage of the binary,
# and its website describes the configuration:
#
#     https://vivien.github.io/i3blocks


# Global properties
separator=true
separator_block_width=35

[weather]
command=/home/jim/weather/target/release/weather
interval=60
markup=pango

[passwords]
command=/home/jim/.local/bin/fish --no-config /home/jim/dot/scripts/passwords-stale.fish
interval=10
color=#D55E00

[dotfiles]
command=/home/jim/.local/bin/fish --no-config /home/jim/dot/scripts/dotfiles-stale.fish
interval=10
color=#D55E00

# Shows the SRS cards awaiting TTS audio and triggers generation on the GPU.
# Hidden when the queue is empty. See ~/helper/docs/srs.md.
[tts]
command=/home/jim/helper/desktop/bin/tts-block.sh
interval=60

[disk]
command=df -h | grep '/$' | awk '{print $4 "iB"}'
interval=30
label=DISK: 

[memory]
command=free -h | grep Mem | awk '{print $7 "B"}'
interval=10
label=RAM: 

[time]
command=date '+%A  %Y-%m-%d %H:%M:%S'
interval=1
